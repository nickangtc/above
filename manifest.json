{
  "manifest_version": 3,
  "name": "Above",
  "version": "0.1.0",
  "description": "Stay above your daily time limits on the sites you choose.",
  "permissions": ["storage", "tabs"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Above — manage site limits" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
